# Fonts (Noto, bundled; see rhdt_mpl.fonts)
font.family: sans-serif
font.sans-serif: Noto Sans
font.serif: Noto Serif
font.monospace: Noto Sans Mono
font.size: 9
axes.titlesize: 10
axes.labelsize: 9
xtick.labelsize: 8
ytick.labelsize: 8
legend.fontsize: 8

# Figure
figure.figsize: 4.0, 2.8
figure.dpi: 150
figure.constrained_layout.use: True
savefig.dpi: 300
savefig.bbox: tight

# Axes
axes.spines.top: False
axes.spines.right: False
axes.linewidth: 0.8
axes.edgecolor: 222222
axes.labelcolor: 000000
axes.axisbelow: True
axes.grid: False
grid.color: DDDDDD
grid.linewidth: 0.6
axes.prop_cycle: cycler('color', ['4477AA', 'EE6677', '228833', 'CCBB44', '66CCEE', 'AA3377'])

# Ticks
xtick.direction: out
ytick.direction: out
xtick.major.size: 3.5
ytick.major.size: 3.5
xtick.minor.size: 2
ytick.minor.size: 2
xtick.major.width: 0.8
ytick.major.width: 0.8
xtick.color: 222222
ytick.color: 222222

# Lines, patches
lines.linewidth: 1.5
lines.markersize: 5
patch.linewidth: 0.8
patch.edgecolor: 222255

# Legend
legend.frameon: False

# Images
image.cmap: viridis
