# Fonts (Noto, bundled; see rhdt_mpl.fonts).  Sizes follow the ML-PWS figures:
# 8 pt text, labels 8.8, titles 9.6 (seaborn "paper" context, then font.size 8).
font.family: sans-serif
font.sans-serif: Noto Sans
font.serif: Noto Serif
font.monospace: Noto Sans Mono
font.size: 8
axes.labelsize: 8.8
axes.titlesize: 9.6
xtick.labelsize: 8
ytick.labelsize: 8
legend.fontsize: 8

# Figure: two-column width of the ML-PWS figures is 510 pt (see rhdt_mpl.TWO_COLUMN)
figure.figsize: 4.0, 2.8
figure.dpi: 150
figure.constrained_layout.use: True
savefig.dpi: 300
savefig.bbox: tight

# Axes: Matplotlib defaults (full box, black, outward ticks), grid off but styled
axes.linewidth: 0.8
axes.axisbelow: True
axes.grid: False
grid.color: B0B0B0
grid.linewidth: 0.8
axes.prop_cycle: cycler('color', ['00A543', 'D139BF', '007AC1', 'BA682C', 'AA1742', '4737E5', '008479', '808C28'])   # colibri (Display P3 numbers)

# Lines and markers (no marker edge)
lines.linewidth: 1.5
lines.markersize: 4
lines.markeredgewidth: 0
patch.linewidth: 0.5

# Legend
legend.frameon: False
legend.handlelength: 2.0
legend.handletextpad: 0.5

# Images
image.cmap: viridis   # overridden by rhdt_mpl.use() with ok_orchid
